local MyButton = LeftWweapon:AddButton({
    Text = 'Infinite Ammo',
    Func = function()
        local player = game.Players.LocalPlayer
		local backpack = player:WaitForChild("Backpack")

		local function setAmmo(tool)
			local settings = tool:FindFirstChild("ACS_Settings")
			if settings and settings:IsA("ModuleScript") then
				local success, cfg = pcall(require, settings)
				if success and cfg.Ammo then
					cfg.Ammo = 9999999
					
				end
			end
		end

		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				setAmmo(tool)
			end
		end

		backpack.ChildAdded:Connect(function(tool)
			if tool:IsA("Tool") then
				setAmmo(tool)
			end
		end)
    end,
    DoubleClick = false,
    Tooltip = 'Infinite Ammo'
})

local MyButton = LeftWweapon:AddButton({
    Text = 'Automatic',
    Func = function()
        local player = game.Players.LocalPlayer
		local backpack = player:WaitForChild("Backpack")

		local function setAmmo(tool)
			local settings = tool:FindFirstChild("ACS_Settings")
			if settings and settings:IsA("ModuleScript") then
