local LeftWweapon = Tabs.Weapons:AddLeftGroupbox('Weapon Modifier')

local MyButton = LeftWweapon:AddButton({
    Text = 'No Recoil',
    Func = function()
	local player = game.Players.LocalPlayer
		local backpack = player:WaitForChild("Backpack")

		for _, tool in ipairs(backpack:GetChildren()) do
			local settings = tool:FindFirstChild("ACS_Settings")
			if settings and settings:IsA("ModuleScript") then
				local success, cfg = pcall(require, settings)
				if success and cfg then
					cfg.MinRecoilPower = 0
					cfg.MaxRecoilPower = 0
					cfg.AimRecoilReduction = 0.1

					if cfg.camRecoil then
						cfg.camRecoil.camRecoilUp = {0.1, 0.1}
						cfg.camRecoil.camRecoilTilt = {0.1, 0.1}
						cfg.camRecoil.camRecoilLeft = {0.1, 0.1}
						cfg.camRecoil.camRecoilRight = {0.1, 0.1}
					end

					if cfg.gunRecoil then
						cfg.gunRecoil.gunRecoilUp = {0.1, 0.1}
						cfg.gunRecoil.gunRecoilTilt = {0.1, 0.1}
						cfg.gunRecoil.gunRecoilLeft = {0.1, 0.1}
						cfg.gunRecoil.gunRecoilRight = {0.1, 0.1}
					end
				end
			end
		end
    end,
    DoubleClick = false,
    Tooltip = 'No Recoil'
})

